# .gitignore — organizado por categoria
# Padroes preexistentes foram preservados; excecoes (!) ficam no fim,
# onde o gitignore garante que prevalecem.

# Ferramentas de IA — nunca versionar
.claude/
.claudesignignore
.cline/
.cline_history/
.codex/
.cursor/
.cursorignore
.cursorrules
.worktrees/
AGENTS.md
CLAUDE.local.md
CLAUDE.md
Cursor.md
GEMINI.md
PROMPTS.md

# Ambientes virtuais
.venv/
env/
venv/

# Python
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
__pycache__/
build/
dist/

# Testes e cobertura
.pytest_cache/

# Jupyter e notebooks
.ipynb_checkpoints/

# Dados, modelos e saidas
*.joblib
*.pkl
outputs/

# LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc

# Bancos de dados locais
Thumbs.db

# IDEs e editores
.idea/
.vscode/

# Sistema operacional
.DS_Store

# Especifico do projeto
*.py[cod]
criar_*.py
corrigir_*.py
reorganizar_*.ps1
cleanup_repository_phase*.py
README.before-*.md
README.backup*.md
README.old*.md
