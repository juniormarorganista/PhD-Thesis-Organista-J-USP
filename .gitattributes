# Normalize text files
* text=auto

# Keep scripts with LF where useful
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.f text eol=lf
*.f90 text eol=lf

# Binary/scientific assets
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.eps binary
*.nb binary

# Git LFS for the generated README/assets preview images only.
# Thesis and Papers figures (.eps, .pdf) and Thesis/Slides graphics are
# committed directly, not through LFS; a blanket extension-based filter
# here previously made Git treat those already-committed files as
# perpetually "modified" (clean-filter mismatch) without any real change.
assets/preview/*.png filter=lfs diff=lfs merge=lfs -text
assets/thesis/**/*.png filter=lfs diff=lfs merge=lfs -text
